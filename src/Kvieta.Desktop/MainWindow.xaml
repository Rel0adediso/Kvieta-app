<Window x:Class="Kvieta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="850" Height="650" MinWidth="510" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Border x:Name="WhatsNewBanner" Visibility="Collapsed" Background="{DynamicResource PrimarySoftBrush}"
                    CornerRadius="9" Padding="10" Margin="0,0,0,16">
                <DockPanel>
                    <Button Content="×" DockPanel.Dock="Right" Click="DismissWhatsNew_Click"
                            AutomationProperties.Name="{DynamicResource WhatsNewDismiss}" Margin="8,0,0,0" Width="28" />
                    <Button Click="WhatsNew_Click" Background="Transparent" BorderThickness="0" Padding="5" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource KvietaUpdatedTitle}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WhatsNewRange" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="{DynamicResource WhatsNewTitle}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
            <TextBlock Text="Kvieta" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock x:Name="Heading" Text="Bugün" FontSize="36" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,12">
            <ItemsControl x:Name="Applications">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="15"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsedText}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="AutomaticUpdates" Content="Otomatik masaüstü güncellemeleri" Margin="0,0,0,8"
                      Checked="AutomaticUpdates_Changed" Unchecked="AutomaticUpdates_Changed"/>
            <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button x:Name="RefreshButton" Content="Yenile" Click="Refresh_Click" Margin="0,0,8,8" Padding="18,8"/>
                <Button x:Name="SettingsButton" Content="Kontrol Merkezi" Click="Settings_Click" Margin="0,0,8,8" Padding="18,8"/>
                <Button Content="{DynamicResource WhatsNewTitle}" Click="WhatsNew_Click" Margin="0,0,8,8" Padding="18,8"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
