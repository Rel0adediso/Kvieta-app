                                                    <Button Content="{DynamicResource ManagerDevice}" Style="{StaticResource SecondaryButtonStyle}" Click="ManagerDevice_Click" Margin="8,0,0,0"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,13" Visibility="{Binding HasPersonalChangeDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource PersonalStrictness}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{DynamicResource PersonalStrictnessDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding UsageModeText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </controls:ResponsiveColumns>
                                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12"/>
                                                    <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{DynamicResource RelaxationDelay}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{DynamicResource RelaxationDelayDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ComboBox ItemsSource="{Binding ChangeDelayOptions}" SelectedItem="{Binding ChangeDelay}" Height="32" VerticalAlignment="Center"/>
                                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPendingChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding PendingChangeText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding PendingChangeDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                                                            <Button Content="{DynamicResource CancelPending}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelPending_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,7,0,0"/>
                                                        </StackPanel>
                                                    </controls:ResponsiveColumns>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,14" Visibility="{Binding IsGuardianRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource DeviceProtection}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource DeviceProtectionDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource FaintTextBrush}" Margin="0,0,7,0" x:Name="ProtectionStatusDot"/>
                                                        <TextBlock x:Name="ProtectionStatusText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <Button x:Name="ProtectionActionButton" Style="{StaticResource SecondaryButtonStyle}" Click="ProtectionAction_Click" Padding="13,6"/>
                                                    </WrapPanel>
                                                </controls:ResponsiveColumns>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Style="{StaticResource SectionExpanderStyle}" Margin="0,12,0,0" Header="{DynamicResource PrivacyCenter}" x:Name="PrivacySection" IsExpanded="False">
                                        <StackPanel Margin="18,8,18,16">
                                            <StackPanel Margin="0,8,0,10" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource AwarenessTracking}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{DynamicResource AwarenessTrackingDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,14,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding AwarenessTrackingEnabled}" IsEnabled="{Binding HasRestrictions}" VerticalAlignment="Center" Content="{DynamicResource AwarenessTrackingConsent}" Checked="AwarenessTracking_Changed" Unchecked="AwarenessTracking_Changed" Margin="0,0,0,10"/>
                                            </StackPanel>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,15">
                                                <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource PrivacyCenter}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource PrivacyCenterDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource RetentionPeriod}" Style="{StaticResource CaptionStyle}" FontSize="9" Margin="0,0,0,5"/>
                                                        <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionPeriod}" Width="145" Height="32" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource RestoreRhythmSuggestions}" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreRhythmSuggestions_Click" Padding="12,6" Margin="0,0,6,0"/>
                                                        <Button Content="{DynamicResource MyData}" Style="{StaticResource ModeSelectorButtonStyle}" Click="MyData_Click" Padding="14,7"/>
                                                    </WrapPanel>
                                                </controls:ResponsiveColumns>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Style="{StaticResource SectionExpanderStyle}" Margin="0,12,0,0" Header="{DynamicResource RecoveryAndRepair}" x:Name="MaintenanceSection" IsExpanded="False">
                                        <StackPanel Margin="18,8,18,16">
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,14">
                                                <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource RecoveryAndRepair}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource RecoveryAndRepairDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <WrapPanel>
                                                        <Button Content="{DynamicResource OpenSessionPreview}" Style="{StaticResource SecondaryButtonStyle}" Click="SessionPreview_Click" Padding="12,6" Margin="0,0,8,0"/>
                                                        <Button Content="{DynamicResource ExportDiagnostics}" Style="{StaticResource SecondaryButtonStyle}" Click="ExportDiagnostics_Click" Padding="12,6" Margin="0,0,8,0"/>
                                                        <Button Content="{DynamicResource OpenRecoveryCenter}" Style="{StaticResource ModeSelectorButtonStyle}" Click="RecoveryCenter_Click"/>
                                                    </WrapPanel>
                                                </controls:ResponsiveColumns>
                                            </Border>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,15">
                                                <StackPanel>
                                                    <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource WorkHealth}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{DynamicResource WorkHealthDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0"/>
                                                        </StackPanel>
                                                        <Button Content="{DynamicResource RetryHealthChecks}" Style="{StaticResource SecondaryButtonStyle}" Click="RetryHealth_Click" Padding="12,6"/>
                                                    </controls:ResponsiveColumns>
                                                    <controls:ResponsiveColumns Margin="0,14,0,0" MinimumColumnWidth="240" MaximumColumns="2">
                                                        <StackPanel Margin="0,0,16,0">
                                                            <TextBlock Text="{DynamicResource MeasurementHealth}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding MeasurementHealthText}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding MeasurementHealthDetailText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="16,0">
                                                            <TextBlock Text="{DynamicResource GuardianHealth}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock x:Name="HealthGuardianText" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                            <TextBlock x:Name="HealthGuardianDetailText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="16,0,0,0">
                                                            <TextBlock Text="{DynamicResource LocalSaveHealth}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding LocalSaveHealthText}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding LocalSaveHealthDetailText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </controls:ResponsiveColumns>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0" Padding="20,14">
                                                <controls:ResponsiveColumns MinimumColumnWidth="240" MaximumColumns="2">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource UninstallTitle}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource UninstallSettingsDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Content="{DynamicResource UninstallAction}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource WarningBrush}" Click="UninstallKvieta_Click" Padding="13,7" VerticalAlignment="Center"/>
                                                </controls:ResponsiveColumns>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Visibility="Collapsed" Text="{Binding SettingsPath}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                            <TextBlock Text="{Binding BuildInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding InstallationInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
            <Grid x:Name="ApplicationDetailsOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{DynamicResource OverlayScrimBrush}" MouseLeftButtonUp="ApplicationDetailsScrim_Click"/>
                <Border x:Name="ApplicationDetailsPanel" Width="480" HorizontalAlignment="Right" Margin="0,12,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.32" Color="#000000"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ApplicationDetailsTranslate" X="520"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,22,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}">
                                        <Path Data="{StaticResource AppsIconGeometry}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource HistoryApplicationDetails}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource HistoryApplicationDetailsDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,9,24,0" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                            <Button x:Name="ApplicationDetailsCloseButton" Grid.Column="1" Content="×" AutomationProperties.Name="{DynamicResource Close}" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="ApplicationDetailsClose_Click" VerticalAlignment="Top"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" Margin="24,0"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,10,10,6">
                            <ItemsControl ItemsSource="{Binding HistoryAllApplications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,4">
                                            <Grid Height="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RankText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Background="{Binding FallbackBrush}" CornerRadius="8">
                                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Border>
                                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar services:MotionAssist.AnimatedValue="{Binding RelativePercent}" Maximum="100" Height="4" Margin="0,6,16,0"/>
                                                </StackPanel>
                                                <controls:Sparkline Grid.Column="3" Values="{Binding TrendValues}" LineBrush="{DynamicResource PrimaryBrush}" Width="82" Height="24" Margin="6,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding UsedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="TourOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Background="Transparent" SizeChanged="TourOverlay_SizeChanged">
                <Path x:Name="TourShade" Fill="#B8000000" IsHitTestVisible="False"/>
                <Canvas x:Name="TourCanvas">
                    <Border x:Name="TourHighlight" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3" CornerRadius="12" IsHitTestVisible="False"/>
                    <Border x:Name="TourCard" Width="330" Padding="22" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TourProgress" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TourTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,10"/>
                            <TextBlock x:Name="TourDescription" FontSize="14" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button x:Name="TourBack" Content="{DynamicResource Back}" Style="{StaticResource SecondaryButtonStyle}" Click="TourBack_Click" Margin="0,0,8,0"/>
                                <Button x:Name="TourNext" Style="{StaticResource PrimaryButtonStyle}" Click="TourNext_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
                <Button x:Name="TourSkip" Content="{DynamicResource SkipTutorial}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="16,10" Style="{StaticResource SecondaryButtonStyle}" Click="TourSkip_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>