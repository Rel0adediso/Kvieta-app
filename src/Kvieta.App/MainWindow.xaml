                                                        <TextBlock Text="{Binding RhythmWeekPatternDetailText}" Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="14"/>
                                                    </StackPanel>
                                                </controls:ResponsiveColumns>
                                                <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="16" Padding="18,14" Margin="0,16,0,0">
                                                    <controls:ResponsiveColumns MinimumColumnWidth="150" MaximumColumns="4">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource RhythmStreak}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding RhythmStreakText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource RhythmBestStreak}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding RhythmBestStreakText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource RhythmProtector}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding RhythmProtectorText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource RhythmFocusTime}" Style="{StaticResource CaptionStyle}"/>
                                                            <TextBlock Text="{Binding RhythmFocusText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </controls:ResponsiveColumns>
                                                </Border>
                                                <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="16" Padding="14,12" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding RhythmDays}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" Columns="7"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Tag="{Binding}" Click="RhythmDay_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0" Padding="5" AutomationProperties.Name="{Binding DetailText}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" FontSize="10"/>
                                                                            <TextBlock Text="{Binding SymbolText}" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Margin="0,3"/>
                                                                            <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding SelectedRhythmDayText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="4,7,4,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <controls:ResponsiveColumns Grid.Row="3" Margin="0,13,0,0" MinimumColumnWidth="260" MaximumColumns="2">
                                                    <Border x:Name="RhythmInsightCard" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="16" Padding="16,13" Margin="0,0,12,0">
                                                        <controls:ResponsiveColumns MinimumColumnWidth="260" MaximumColumns="2">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Path Data="{StaticResource InsightIconGeometry}" Fill="{DynamicResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding RhythmInsightText}" services:MotionAssist.AnimateTextChanges="True" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding RhythmSuggestionPreviewText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="21,4,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <WrapPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <Button Content="{DynamicResource ApplySuggestion}" IsEnabled="{Binding CanApplyRhythmSuggestion}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Click="ApplyRhythmSuggestion_Click"/>
                                                                <Button Content="{DynamicResource RemindLater}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="5,0,0,0" Click="RhythmSuggestionLater_Click"/>
                                                                <Button Content="{DynamicResource HideSuggestion}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="5,0,0,0" Click="HideRhythmSuggestion_Click"/>
                                                            </WrapPanel>
                                                        </controls:ResponsiveColumns>
                                                    </Border>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource ReviewSummaryAction}" Visibility="{Binding IsInsightsMode, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="ReviewSummary_Click"/>
                                                        <Button Content="{DynamicResource ShareRhythm}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,8,0" Click="ShareRhythm_Click"/>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{DynamicResource DailyRhythmGoal}" Style="{StaticResource CaptionStyle}" FontSize="10.5"/>
                                                            <TextBlock Text="{Binding RhythmTodayProgressText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,3,0,0" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <ComboBox ItemsSource="{Binding DailyRhythmGoalOptions}" SelectedItem="{Binding DailyRhythmGoal}" Width="145" Height="32" Margin="0,0,7,0"/>
                                                        <ComboBox ItemsSource="{Binding ReductionGoalOptions}" SelectedItem="{Binding ReductionGoal}" SelectionChanged="ReductionGoal_SelectionChanged" Width="118" Height="32"/>
                                                    </WrapPanel>
                                                </controls:ResponsiveColumns>
                                                <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="16" Padding="16,13" Margin="0,12,0,0">
                                                    <controls:ResponsiveColumns MinimumColumnWidth="260" MaximumColumns="2">
                                                        <StackPanel>
                                                            <StackPanel Visibility="{Binding HasRhythmFirstStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding RhythmFirstStepTitle}" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding RhythmFirstStepText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,12,7"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding RhythmComparisonPeriodText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RhythmMetricExplanationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                                        </StackPanel>
                                                        <Button Content="{Binding RhythmFirstStepActionText}" Visibility="{Binding HasRhythmFirstStep, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" VerticalAlignment="Center" Click="RhythmFirstStep_Click"/>
                                                    </controls:ResponsiveColumns>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                    <controls:ResponsiveColumns Grid.Row="3" Margin="0,14,0,0" MinimumColumnWidth="330" MaximumColumns="2">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="20" Margin="0,0,7,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,9">
                                                    <TextBlock Text="{DynamicResource HistoryLastSevenDays}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SelectedHistoryDaySummaryText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding HistoryDays}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource HistoryDayItemStyle}" Tag="{Binding}" Click="HistoryDay_Click" AutomationProperties.Name="{Binding DayText}">
                                                                <Grid Height="42">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="68"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="68"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DayText}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="7"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <ProgressBar Grid.Row="0" services:MotionAssist.AnimatedValue="{Binding RelativePercent}" Maximum="100" Height="5" Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource PrimaryBrush}"/>
                                                                        <TextBlock Grid.Row="2" Text="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="2" Text="{Binding UsedText}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="7,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="20">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource HistoryRecentEvents}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding HistoryEvents}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Height="34">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="78"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="14,12" Margin="0,12,0,4" Visibility="{Binding HasNoHistoryEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource NoHistoryEvents}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </controls:ResponsiveColumns>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem>
                            <ScrollViewer x:Name="SettingsScrollViewer" services:MotionAssist.SmoothScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="28,24,28,36" MaxWidth="880">
                                    <!-- Page Header -->
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="{DynamicResource SettingsDescription}" Style="{StaticResource PageDescriptionStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Section 1: Appearance & General -->
                                    <Expander Style="{StaticResource SettingsExpanderStyle}" x:Name="AppearanceSection" IsExpanded="False" Expanded="SettingsSection_Expanded">
                                        <Expander.Header>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource PaletteIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource AppearanceAndLanguage}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource AppearanceDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <!-- Theme -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource Appearance}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource AppearanceDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <controls:SlidingSegmentedControl Grid.Column="1" Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}" SelectionChanged="Theme_SelectionChanged" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Language -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource Language}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource LanguageDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <controls:SlidingSegmentedControl Grid.Column="1" Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding LanguageModes}" SelectedItem="{Binding LanguageMode}" SelectionChanged="Language_SelectionChanged" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Interface Scale -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource InterfaceSize}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Arayüz ve metin ölçeklendirmesini ekranınıza göre ayarlayın" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" x:Name="ZoomSelector" Width="110" Height="32" SelectedIndex="0" SelectionChanged="Zoom_SelectionChanged" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="100%" Tag="100"/>
                                                        <ComboBoxItem Content="110%" Tag="110"/>
                                                        <ComboBoxItem Content="125%" Tag="125"/>
                                                        <ComboBoxItem Content="150%" Tag="150"/>
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                            <!-- Animations -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource AnimationsEnabled}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource AnimationsDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding AnimationsEnabled}" Checked="Animations_Changed" Unchecked="Animations_Changed" Content="{DynamicResource Enabled}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Start With Windows -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource StartWithWindows}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource StartWithWindowsDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" Content="{DynamicResource Enabled}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Device Name -->
                                            <Border BorderThickness="0" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource DeviceName}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource DeviceNameDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Style="{StaticResource PlanInputStyle}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Width="220" Height="34" MinHeight="34" Padding="12,0" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Section 2: Protection Settings -->
                                    <Expander Style="{StaticResource SettingsExpanderStyle}" x:Name="ProtectionSection" IsExpanded="False" Expanded="SettingsSection_Expanded">
                                        <Expander.Header>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource ShieldIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource ProtectionSettings}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource UsageModeDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <!-- Usage Mode -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource UsageMode}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource UsageModeDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource ModeSelectorButtonStyle}" Click="ChangeMode_Click" ToolTip="{DynamicResource ChangeMode}" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="3" Height="18" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding UsageModeText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                                                                <TextBlock Text="›" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-2,0,0"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <!-- When Time Runs Out -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource WhenTimeEnds}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource WhenTimeEndsDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <controls:SlidingSegmentedControl Grid.Column="1" Style="{StaticResource SegmentListStyle}" ItemContainerStyle="{StaticResource SegmentItemStyle}" ItemsSource="{Binding LimitActions}" SelectedItem="{Binding LimitAction}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Admin Pin -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14" Visibility="{Binding IsFamilyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource AdminPin}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource AdminPinDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding HasAdminPin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{DynamicResource AdminPinActive}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Button Content="{Binding AdminPinActionText}" Style="{StaticResource SecondaryButtonStyle}" Click="AdminPin_Click" Padding="12,6"/>
                                                        <Button Content="{DynamicResource RecoveryCodes}" Style="{StaticResource SecondaryButtonStyle}" Click="RecoveryCodes_Click" Margin="8,0,0,0" Padding="12,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!-- Relaxation Delay -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14" Visibility="{Binding HasPersonalChangeDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource RelaxationDelay}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource RelaxationDelayDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChangeDelayOptions}" SelectedItem="{Binding ChangeDelay}" Width="150" Height="32" VerticalAlignment="Center"/>
                                                    <!-- Pending Change -->
                                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding HasPendingChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PendingChangeText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding PendingChangeDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" LineHeight="16"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{DynamicResource CancelPending}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelPending_Click" Padding="12,5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Device Protection Guardian -->
                                            <Border BorderThickness="0" Padding="18,14" Visibility="{Binding IsGuardianRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource DeviceProtection}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource DeviceProtectionDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource FaintTextBrush}" Margin="0,0,8,0" x:Name="ProtectionStatusDot" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ProtectionStatusText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <Button x:Name="ProtectionActionButton" Style="{StaticResource SecondaryButtonStyle}" Click="ProtectionAction_Click" Padding="14,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Section 3: Privacy Center -->
                                    <Expander Style="{StaticResource SettingsExpanderStyle}" x:Name="PrivacySection" IsExpanded="False" Expanded="SettingsSection_Expanded">
                                        <Expander.Header>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource LockIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource PrivacyCenter}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource PrivacyCenterDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <!-- Mobile Companion -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource AndroidDashboard}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Telefonunuzu eşleştirerek sürenizi uzaktan yönetin ve anlık bildirimleri alın" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="AndroidDashboard_Click" Padding="14,7" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource PhoneIconGeometry}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{DynamicResource AndroidDashboard}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <!-- Awareness Tracking -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14" Visibility="{Binding HasRestrictions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource AwarenessTracking}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource AwarenessTrackingDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding AwarenessTrackingEnabled}" IsEnabled="{Binding HasRestrictions}" VerticalAlignment="Center" Content="{DynamicResource AwarenessTrackingConsent}" Checked="AwarenessTracking_Changed" Unchecked="AwarenessTracking_Changed"/>
                                                </Grid>
                                            </Border>
                                            <!-- Retention Period -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource RetentionPeriod}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Cihazınızda yerel olarak saklanan kullanım kayıtlarının süresi" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionPeriod}" Width="150" Height="32" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Data and Rhythm -->
                                            <Border BorderThickness="0" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource PrivacyCenter}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource PrivacyCenterDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource RestoreRhythmSuggestions}" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreRhythmSuggestions_Click" Padding="12,6" Margin="0,0,8,0"/>
                                                        <Button Content="{DynamicResource MyData}" Style="{StaticResource ModeSelectorButtonStyle}" Click="MyData_Click" Padding="14,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Section 4: Maintenance & Health -->
                                    <Expander Style="{StaticResource SettingsExpanderStyle}" x:Name="MaintenanceSection" IsExpanded="False" Expanded="SettingsSection_Expanded">
                                        <Expander.Header>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource WrenchIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource RecoveryAndRepair}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{DynamicResource RecoveryAndRepairDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel>
                                            <!-- Health Checks -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,16">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource WorkHealth}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource WorkHealthDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{DynamicResource RetryHealthChecks}" Style="{StaticResource SecondaryButtonStyle}" Click="RetryHealth_Click" Padding="13,6" VerticalAlignment="Center"/>
                                                    <!-- Health Cards -->
                                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource MeasurementHealth}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                <TextBlock Text="{Binding MeasurementHealthText}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                                <TextBlock Text="{Binding MeasurementHealthDetailText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource GuardianHealth}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                <TextBlock x:Name="HealthGuardianText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                                <TextBlock x:Name="HealthGuardianDetailText" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="4" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource LocalSaveHealth}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                <TextBlock Text="{Binding LocalSaveHealthText}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                                <TextBlock Text="{Binding LocalSaveHealthDetailText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <!-- Diagnostics Tools -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource RecoveryAndRepair}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource RecoveryAndRepairDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource OpenSessionPreview}" Style="{StaticResource SecondaryButtonStyle}" Click="SessionPreview_Click" Padding="12,6" Margin="0,0,8,0"/>
                                                        <Button Content="{DynamicResource ExportDiagnostics}" Style="{StaticResource SecondaryButtonStyle}" Click="ExportDiagnostics_Click" Padding="12,6" Margin="0,0,8,0"/>
                                                        <Button Content="{DynamicResource OpenRecoveryCenter}" Style="{StaticResource ModeSelectorButtonStyle}" Click="RecoveryCenter_Click" Padding="14,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!-- Uninstall -->
                                            <Border BorderThickness="0" Padding="18,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <TextBlock Text="{DynamicResource UninstallTitle}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource UninstallSettingsDescription}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{DynamicResource UninstallAction}" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource DangerBrush}" Click="UninstallKvieta_Click" Padding="14,6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Footer Bar -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="CheckUpdatesButton" Content="{Binding UpdateStatusText}" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="12,6" Click="CheckUpdates_Click"/>
                                                <Button x:Name="DownloadUpdateButton" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{Binding UpdateBadgeText}" Style="{StaticResource PrimaryButtonStyle}" FontSize="11" Margin="10,0,0,0" Padding="12,6" Click="DownloadUpdate_Click"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BuildInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="11" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding InstallationInformationText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" TextAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
            <Grid x:Name="ApplicationDetailsOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="{DynamicResource OverlayScrimBrush}" MouseLeftButtonUp="ApplicationDetailsScrim_Click"/>
                <Border x:Name="ApplicationDetailsPanel" Width="560" HorizontalAlignment="Right" Margin="0,12,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.32" Color="#000000"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ApplicationDetailsTranslate" X="600"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="24,22,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}">
                                        <Path Data="{StaticResource AppsIconGeometry}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedApplicationCategoryName}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource HistoryApplicationDetailsDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,9,24,0" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                            <Button x:Name="ApplicationDetailsCloseButton" Grid.Column="1" Content="×" AutomationProperties.Name="{DynamicResource Close}" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="ApplicationDetailsClose_Click" VerticalAlignment="Top"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" Margin="24,0"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,10,10,6">
                            <ItemsControl x:Name="ApplicationDetailsList" ItemsSource="{Binding FilteredApplications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,4">
                                            <Grid Height="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RankText}" Foreground="{DynamicResource FaintTextBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Background="{Binding FallbackBrush}" CornerRadius="8">
                                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Border>
                                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar services:MotionAssist.AnimatedValue="{Binding RelativePercent}" Maximum="100" Height="4" Margin="0,6,16,0"/>
                                                </StackPanel>
                                                <controls:Sparkline Grid.Column="3" Values="{Binding TrendValues}" LineBrush="{DynamicResource PrimaryBrush}" Width="82" Height="24" Margin="6,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding UsedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <Button Grid.Column="5" Content="{DynamicResource SetAppTimer}" Style="{StaticResource SecondaryButtonStyle}" FontSize="9.5" Padding="8,5" Margin="9,0,0,0" Click="CreateRuleMenu_Click" Visibility="{Binding DataContext.HasRestrictions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="TourOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Background="Transparent" SizeChanged="TourOverlay_SizeChanged">
                <Path x:Name="TourShade" Fill="#B8000000" IsHitTestVisible="False"/>
                <Canvas x:Name="TourCanvas">
                    <Border x:Name="TourHighlight" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3" CornerRadius="12" IsHitTestVisible="False"/>
                    <Border x:Name="TourCard" Width="330" Padding="22" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TourProgress" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TourTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,10"/>
                            <TextBlock x:Name="TourDescription" FontSize="14" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button x:Name="TourBack" Content="{DynamicResource Back}" Style="{StaticResource SecondaryButtonStyle}" Click="TourBack_Click" Margin="0,0,8,0"/>
                                <Button x:Name="TourNext" Style="{StaticResource PrimaryButtonStyle}" Click="TourNext_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
                <Button x:Name="TourSkip" Content="{DynamicResource SkipTutorial}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="16,10" Style="{StaticResource SecondaryButtonStyle}" Click="TourSkip_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
