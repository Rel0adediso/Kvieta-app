<Window x:Class="Kvieta.App.ModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" Height="560" MinWidth="460" MinHeight="340" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="True" Title="Kvieta" Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Border.Resources>
            <Style x:Key="ModeCardStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
            <Style x:Key="SelectedModeCardStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Padding" Value="22" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="16,0"><TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"  TextWrapping="Wrap"/><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" /></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
            <Grid x:Name="UsageStepPanel" MinHeight="0" Margin="34,26,34,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ChooseModeTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"  TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource ChooseModeDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,22"  TextWrapping="Wrap"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="InsightsButton" Tag="Insights" Style="{StaticResource ModeCardStyle}" Click="Insights_Click" MouseDoubleClick="ModeCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource InsightsMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource InsightsModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource InsightsModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="PersonalButton" Tag="Personal" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Personal_Click" MouseDoubleClick="ModeCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource PersonalMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource PersonalModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="FamilyButton" Tag="Family" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="Family_Click" MouseDoubleClick="ModeCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource FamilyMode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource FamilyModeDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource FamilyModeHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="{DynamicResource ModeCanChangeLater}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"  TextWrapping="Wrap"/><Button x:Name="ConfirmModeButton" Grid.Column="2" Content="{DynamicResource ConfirmModeSelection}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="128" Padding="14,7" Click="Confirm_Click" /></Grid>
            </Grid>
            <Grid x:Name="PersonalStepPanel" MinHeight="350" Margin="34,26,34,30" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource ChoosePersonalLevelTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"  TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource ChoosePersonalLevelDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,22"  TextWrapping="Wrap"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="FlexibleButton" Tag="Flexible" Style="{StaticResource ModeCardStyle}" Click="Flexible_Click" MouseDoubleClick="PersonalLevelCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource PersonalFlexible}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource PersonalFlexibleDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalFlexibleHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="BalancedButton" Tag="Balanced" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Balanced_Click" MouseDoubleClick="PersonalLevelCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource PersonalBalanced}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource PersonalBalancedDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalBalancedHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                    <Button x:Name="ProtectedLevelButton" Tag="Protected" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="ProtectedLevel_Click" MouseDoubleClick="PersonalLevelCard_MouseDoubleClick"><StackPanel><TextBlock Text="{DynamicResource PersonalProtected}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold"  TextWrapping="Wrap"/><TextBlock Text="{DynamicResource PersonalProtectedDescription}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" Opacity="0.78" /><TextBlock Text="{DynamicResource PersonalProtectedHint}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" Opacity="0.9" /></StackPanel></Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions><Button Content="{DynamicResource Back}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinWidth="108" Padding="14,7" Click="Back_Click" /><TextBlock Grid.Column="1" Text="{DynamicResource PersonalLevelCanChangeLater}" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"  TextWrapping="Wrap"/><Button Grid.Column="2" Content="{DynamicResource ConfirmModeSelection}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="128" Padding="14,7" Click="ConfirmPersonal_Click" /></Grid>
            </Grid>
            <Grid x:Name="ProtectionSummaryPanel" Margin="42,24,42,30" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="ProtectionSummaryTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProtectionSummaryDescription" Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,14"/>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock x:Name="ProtectionOutcomeText" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"/><TextBlock x:Name="ProtectionBoundaryText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16" Margin="0,10,0,0"/><TextBlock x:Name="ProtectionRecoveryText" Foreground="{DynamicResource PrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16" Margin="0,10,0,0"/></StackPanel></Border>
                <CheckBox x:Name="ProtectionAcknowledgement" Grid.Row="3" Margin="2,12,0,0" Checked="ProtectionAcknowledgement_Changed" Unchecked="ProtectionAcknowledgement_Changed"/>
                <Grid Grid.Row="4" Margin="0,14,0,0"><Button x:Name="ProtectionBackButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinWidth="108" Padding="14,7" Click="ProtectionBack_Click"/><Button x:Name="ProtectionContinueButton" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="150" Padding="14,7" IsEnabled="False" Click="ProtectionContinue_Click"/></Grid>
            </Grid>
            </Grid></ScrollViewer>
        </Grid>
    </Border>
</Window>
