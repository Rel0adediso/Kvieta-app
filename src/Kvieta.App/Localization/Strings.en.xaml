    <sys:String x:Key="PersonalFlexible">Flexible</sys:String>
    <sys:String x:Key="PersonalFlexibleDescription">Start, pause, and end manual focus sessions without using a schedule.</sys:String>
    <sys:String x:Key="PersonalFlexibleHint">There are no time-window or daily-limit blocks. App rules apply only during a session; Guardian is not used.</sys:String>
    <sys:String x:Key="PersonalBalanced">Balanced</sys:String>
    <sys:String x:Key="PersonalBalancedDescription">Disables instant extra time and delays rule relaxations.</sys:String>
    <sys:String x:Key="PersonalBalancedHint">There is no service protection against closing Kvieta.</sys:String>

