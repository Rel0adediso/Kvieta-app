<Window x:Class="Kvieta.App.DashboardSharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Kvieta.App.Services"
        Title="Kvieta · Mobil Eşlikçi" Width="540" Height="700" MinWidth="440" MinHeight="550"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Geometry x:Key="PhoneIconGeometry">M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M11,18 H13</Geometry>
        <Geometry x:Key="ShieldIconGeometry">M12,2 L4,5 V11 C4,16.5 7.5,21.5 12,23 C16.5,21.5 20,16.5 20,11 V5 Z</Geometry>
        <Geometry x:Key="LockIconGeometry">M19,11 H5 C3.9,11 3,11.9 3,13 V20 C3,21.1 3.9,22 5,22 H19 C20.1,22 21,21.1 21,20 V13 C21,11.9 20.1,11 19,11 Z M7,11 V7 C7,4.2 9.2,2 12,2 C14.8,2 17,4.2 17,7 V11</Geometry>
        <Geometry x:Key="ChevronIconGeometry">M9,6 L15,12 L9,18</Geometry>
        <Geometry x:Key="CloseIconGeometry">M18,6 L6,18 M6,6 L18,18</Geometry>
        <Geometry x:Key="QrIconGeometry">M3,3 H9 V9 H3 Z M15,3 H21 V9 H15 Z M3,15 H9 V21 H3 Z M14,14 H16 V16 H14 Z M18,14 H20 V16 H18 Z M16,16 H18 V18 H16 Z M14,18 H16 V20 H14 Z M18,18 H20 V20 H18 Z M5,5 V7 H7 V5 Z M17,5 V7 H19 V5 Z M5,17 V19 H7 V17 Z</Geometry>

        <Style x:Key="DialogExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="16,12" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center">
                                                        <Path x:Name="Chevron" Data="{StaticResource ChevronIconGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentControl Content="{TemplateBinding Header}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </ToggleButton>
                                <Border x:Name="Divider" Height="1" Background="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="SectionContent" Visibility="Collapsed" ContentSource="Content" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" MouseDown="Window_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="18,0,12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource PhoneIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kvieta Mobil" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="Close_Click" IsCancel="True" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Kapat (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <Path Data="{StaticResource CloseIconGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" services:MotionAssist.SmoothScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,26">
                    <!-- Heading & Explanation -->
                    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Explanation" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,5,0,16"/>

                    <!-- Main Hub Card -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <!-- Card Header (Centered) -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="{StaticResource PhoneIconGeometry}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UsageTitle" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="UsagePermission" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- QR Frame -->
                            <Border x:Name="QrBorder" Background="White" Padding="14" CornerRadius="12" HorizontalAlignment="Center" Margin="0,4,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.10" Color="#000000"/>
                                </Border.Effect>
                                <Image x:Name="QrImage" Width="205" Height="205"/>
                            </Border>

                            <!-- Manual Invite Expander -->
                            <Expander x:Name="ManualInvite" Style="{StaticResource DialogExpanderStyle}" IsExpanded="False" Margin="0,0,0,12">
                                <Border Padding="14">
                                    <TextBox x:Name="InvitationBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" MaxHeight="85" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8"/>
                                </Border>
                            </Expander>

                            <!-- Status & Code Block (Centered Hero Card) -->
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="20,12" HorizontalAlignment="Center" Margin="0,4,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CodeText" FontSize="28" FontFamily="Consolas, Segoe UI Mono, Segoe UI" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Approve Button -->
                            <Button x:Name="ApproveButton" Click="Approve_Click" Style="{StaticResource PrimaryButtonStyle}" Height="38" FontSize="13" Margin="0,0,0,10" HorizontalAlignment="Center" Padding="24,0" Visibility="Collapsed"/>

                            <!-- Features Chips -->
                            <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,12">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                                    <TextBlock Text="🔒 Uzaktan Kilit" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                                    <TextBlock Text="☕ Mola Ver" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                                    <TextBlock Text="⏱️ Ek Süre Yanıtla" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Remote Access Info & Button (Centered) -->
                            <StackPanel Margin="0,2,0,10" HorizontalAlignment="Center">
                                <TextBlock x:Name="RemoteHint" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,0,0,10"/>
                                <Button x:Name="RemoteButton" Click="Remote_Click" Style="{StaticResource PrimaryButtonStyle}" Height="34" FontSize="12" Padding="20,0" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- Actions Row (Centered) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button x:Name="RenewButton" Click="Renew_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" FontSize="12" Padding="16,0" Margin="0,0,10,0"/>
                                <Button x:Name="RevokeButton" Click="Revoke_Click" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Height="34" FontSize="12" Padding="16,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Recovery Section -->
                    <Expander x:Name="RecoverySection" Style="{StaticResource DialogExpanderStyle}" IsExpanded="False" Margin="0,14,0,0">
                        <Border Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="RecoveryStatus" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RecoveryHint" FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button x:Name="RecoveryButton" Click="Recovery_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" FontSize="12" Padding="14,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Trust / Privacy Hint -->
                    <TextBlock x:Name="SharingHint" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource FaintTextBrush}" LineHeight="15" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
