<Window x:Class="Kvieta.App.DashboardSharingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="580" Height="800" MinWidth="440" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded" Closed="Window_Closed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,10,0,18"/>
            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="22" Padding="22">
              <StackPanel>
                <TextBlock x:Name="UsageTitle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="UsagePermission" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,18"/>
            <Border x:Name="QrBorder" Background="White" Padding="14" CornerRadius="14" HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="230" Height="230"/>
            </Border>
            <Expander x:Name="ManualInvite" IsExpanded="False" Margin="0,14,0,8">
                <TextBox x:Name="InvitationBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" MaxHeight="85" VerticalScrollBarVisibility="Auto"/>
            </Expander>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12"/>
            <TextBlock x:Name="CodeText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8"/>
            <Button x:Name="ApproveButton" Click="Approve_Click" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" Margin="0,8"/>
            <Button x:Name="RenewButton" Click="Renew_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8"/>
            <Button x:Name="RevokeButton" Click="Revoke_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8"/>
            <TextBlock x:Name="RemoteHint" TextWrapping="Wrap" Margin="0,10"/>
            <Button x:Name="RemoteButton" Click="Remote_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8"/>
              </StackPanel>
            </Border>
            <Expander x:Name="RecoverySection" IsExpanded="False" Style="{StaticResource SectionExpanderStyle}" Margin="0,16,0,0">
                <StackPanel Margin="18,10,18,18">
                    <TextBlock x:Name="RecoveryStatus" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RecoveryHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,12"/>
                    <Button x:Name="RecoveryButton" Click="Recovery_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="SharingHint" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
