<Window x:Class="Kvieta.App.DesktopToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta Bildirim" Width="340" Height="86" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        Focusable="False">
    <Border x:Name="ToastSurface" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="14" Padding="14,10" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="12" ShadowDepth="3" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon Indicator -->
            <Border Grid.Column="0" x:Name="IconBadge" Width="36" Height="36" CornerRadius="10"
                    Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="IconText" Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Kvieta Kural Bildirimi"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MessageText" Text="Uygulama kullanım süresi sınırına ulaşıldı."
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="✕" Width="20" Height="20"
                    Style="{StaticResource GhostButtonStyle}" FontSize="10"
                    Foreground="{DynamicResource MutedTextBrush}"
                    VerticalAlignment="Top" Click="CloseButton_Click" Margin="4,0,-4,0" />
        </Grid>
    </Border>
</Window>
