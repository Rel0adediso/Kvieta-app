<Window x:Class="Kvieta.App.SessionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta" Width="620" Height="470" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="{DynamicResource SessionPreviewBadge}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="Bold"/></Border>
                <TextBlock Text="{DynamicResource SessionPreviewTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="×" Width="34" Height="34" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" AutomationProperties.Name="{DynamicResource Close}"/>
        </Grid>
        <TextBlock Grid.Row="1" Text="{DynamicResource SessionPreviewDescription}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SessionPreviewWarningTitle}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WarningText" Foreground="{DynamicResource WarningBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <TextBlock Text="{DynamicResource SessionPreviewWarningDescription}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SessionPreviewExpiredTitle}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource SessionPreviewExpiredDescription}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/>
                    <Button Content="{DynamicResource RequestTime}" Style="{StaticResource PrimaryButtonStyle}" Click="ExampleAction_Click" Tag="request-time" HorizontalAlignment="Stretch"/>
                    <Button Content="{DynamicResource WorkSaved}" Style="{StaticResource SecondaryButtonStyle}" Click="ExampleAction_Click" Tag="save-work" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="ExampleResultText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource SessionPreviewNoChanges}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
            <Button Grid.Column="1" Content="{DynamicResource Close}" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
