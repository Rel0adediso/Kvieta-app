<Window x:Class="Kvieta.App.MobileTimeRequestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="390" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="16,0"><TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/></Grid></Border>
            <StackPanel Grid.Row="1" Margin="28,24">
                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>
                <UniformGrid Columns="3"><Button x:Name="Minutes15" Tag="15" Style="{StaticResource SecondaryButtonStyle}" Click="Select_Click" Margin="0,0,6,0"/><Button x:Name="Minutes30" Tag="30" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click" Margin="3,0"/><Button x:Name="Minutes60" Tag="60" Style="{StaticResource SecondaryButtonStyle}" Click="Select_Click" Margin="6,0,0,0"/></UniformGrid>
                <TextBlock x:Name="NoteLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,20,0,7"/>
                <TextBox x:Name="NoteInput" Height="72" Padding="12,9" MaxLength="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="SelectedText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0"/>
                <Button x:Name="SendButton" Style="{StaticResource PrimaryButtonStyle}" Click="Send_Click" HorizontalAlignment="Right" MinWidth="130" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
