<Window x:Class="Kvieta.App.DopamineBarrierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kvieta · Dopamin Tuzağı Koruması"
        Width="600" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <!-- Ambient Depth Shadow -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1.5" CornerRadius="28"
                Padding="36,30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="36" ShadowDepth="12" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <!-- Top Bar: Badge and Close Button -->
                <Grid Margin="0,0,0,16">
                    <Border Background="{DynamicResource PrimarySoftBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="20" Padding="12,5" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛑" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProtectionBadge" Text="DOPAMİN TUZAĞI KORUMASI" Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CloseAction" Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="0" FontSize="12"
                            IsCancel="True" Click="CloseButton_Click" ToolTip="Kapat ve Ana Sayfaya Dön" />
                </Grid>

                <!-- Hero Icon Visual -->
                <Border Width="76" Height="76" CornerRadius="38"
                        Background="{DynamicResource PrimarySoftBrush}"
                        HorizontalAlignment="Center" Margin="0,4,0,16">
                    <Grid>
                        <Border Width="60" Height="60" CornerRadius="30"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z"
                                          Fill="{DynamicResource PrimarySoftBrush}"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M9 9v6 M15 9v6"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Title & Empathetic Message -->
                <TextBlock x:Name="TitleText" Text="Kısa Video Akışı Durduruldu"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="DescriptionText"
                           Text="Shorts ve Reels gibi dikey sonsuz video akışları zihnini yormamak ve odaklanmanı korumak için durduruldu. Tarayıcın kapatılmadı; dilediğin yöne geçebilirsin."
                           FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"
                           MaxWidth="490" Margin="0,0,0,24" />

                <!-- Action Area -->
                <StackPanel Margin="0,0,0,6">
                    <!-- Primary Hero Action -->
                    <Button x:Name="GoHomeButton" Style="{StaticResource PrimaryButtonStyle}"
                            Height="46" Padding="20,0" Margin="0,0,0,10"
                            HorizontalAlignment="Stretch" IsDefault="True" Click="GoHome_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="GoHomeButtonText" Text="YouTube Ana Sayfasına Git" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Secondary Supporting Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="GoBackButton" Style="{StaticResource SecondaryButtonStyle}"
                                Height="40" Padding="14,0" Click="GoBack_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="‹" FontSize="17" FontWeight="Bold" Margin="0,-2,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BackLabel" Text="Önceki Sayfaya Dön" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="NewTabButton" Style="{StaticResource SecondaryButtonStyle}"
                                Height="40" Padding="14,0" Click="NewTab_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BlankLabel" Text="Boş Sekmeye Geç" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Mindful Calm Hint Bar (Never rushes or disappears automatically) -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14" Padding="16,12" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="HintLabel" Text="Zihnini toparla. Dilediğin seçeneğe tıklayabilir veya Ana Sayfa için Enter'a basabilirsin."
                                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>