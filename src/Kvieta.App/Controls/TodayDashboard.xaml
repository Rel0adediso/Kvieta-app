<UserControl x:Class="Kvieta.App.Controls.TodayDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kvieta.App.Controls"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="QuietLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HourButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HourSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HourSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HourSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,8,0,26" ClipToBounds="True">
            <Viewbox Width="245" Height="245" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-28,-20,-28" Opacity="0.065" IsHitTestVisible="False" Focusable="False">
                <Canvas Width="320" Height="320">
                    <Path Fill="{DynamicResource PrimaryBrush}" Data="M63 61 C53 61 45 69 45 79 L45 279 C45 290 53 298 64 298 L92 298 C103 298 111 290 111 279 L111 234 C111 223 106 216 98 207 C84 192 83 171 93 153 C99 143 111 134 111 120 L111 79 C111 69 103 61 93 61 Z"/>
                    <Path Fill="{DynamicResource PrimaryBrush}" Data="M247 38 C261 36 273 42 275 54 C277 66 272 76 264 84 L179 175 C171 183 172 193 181 199 L245 242 C259 251 267 264 265 278 C263 293 254 304 240 308 C226 311 216 307 205 299 L106 211 C95 201 91 190 94 176 C96 165 101 157 110 149 L227 47 C233 42 240 39 247 38 Z"/>
                </Canvas>
            </Viewbox>
            <StackPanel>
                <WrapPanel Margin="0,0,0,15">
                    <TextBlock Text="KVIETA / " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TodayDateText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                </WrapPanel>
                <TextBlock Text="{Binding TodayHeadline}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" LineHeight="44" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding TodayLeadText}" Style="{StaticResource QuietLabel}" FontSize="13" Margin="0,14,0,0" MaxWidth="540" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="24">
            <StackPanel>
                <local:ResponsiveColumns MinimumColumnWidth="310" MaximumColumns="2">
                    <Grid Margin="0,3,8,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource TodayMeasuredApps}" Style="{StaticResource QuietLabel}"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="58" Margin="0,9,0,9">
                                <TextBlock Text="{Binding TodayMeasuredText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding TodayMeasuredChangeText}" Style="{StaticResource QuietLabel}" FontSize="11"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="132" Height="132" VerticalAlignment="Center">
                            <local:UsageDonutChart ItemsSource="{Binding TodayApplications}" TrackBrush="{DynamicResource SurfaceHoverBrush}" StrokeThickness="14" IsHitTestVisible="False" Focusable="False"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodayApplications.Count}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TodayAppCountLabel}" Style="{StaticResource QuietLabel}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource TodayTopApplications}" Style="{StaticResource QuietLabel}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopTodayApplications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" HorizontalAlignment="Left">
                                            <Border Background="{Binding FallbackBrush}" CornerRadius="8">
                                                <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFallbackIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Value="{Binding RelativePercent, Mode=OneWay}" Foreground="{Binding FallbackBrush}" Height="3" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding UsedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,7,0,0" Visibility="{Binding HasTodayOtherUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SurfaceHoverBrush}" Margin="10,0,18,0"/>
                            <TextBlock Text="{Binding TodayOtherUsageText}" Style="{StaticResource QuietLabel}" DockPanel.Dock="Right"/>
                            <TextBlock Text="{DynamicResource TodayOtherApplications}" Style="{StaticResource QuietLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource NoTodayApplications}" Style="{StaticResource QuietLabel}" Margin="0,12,0,0" Visibility="{Binding HasNoTodayApplications, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </local:ResponsiveColumns>
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14,10" Margin="0,18,0,0" Visibility="{Binding ShowTodayScheduledLimit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource RemainingTime}" Style="{StaticResource QuietLabel}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding RemainingText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TodayLimitDisplayText}" Style="{StaticResource QuietLabel}" FontSize="10" HorizontalAlignment="Right"/>
                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Height="3" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="20" Padding="22,18" Margin="0,14,0,0">
            <local:ResponsiveColumns MinimumColumnWidth="260" MaximumColumns="2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource TodayNextMoment}" Foreground="{DynamicResource PrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TodayPrimaryActionHint}" Style="{StaticResource QuietLabel}" Margin="0,5,12,0"/>
                </StackPanel>
                <Button Content="{Binding TodayPrimaryActionText}" Style="{StaticResource PrimaryButtonStyle}" Padding="22,13" HorizontalAlignment="Right" VerticalAlignment="Center" Click="PrimaryAction_Click"/>
            </local:ResponsiveColumns>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="24,22" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{DynamicResource TodayHourlyScale}" Style="{StaticResource QuietLabel}" FontSize="10" DockPanel.Dock="Right" Margin="12,4,0,0"/>
                    <TextBlock Text="{DynamicResource TodayDayFlow}" FontSize="19" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource TodayHourlyHint}" Style="{StaticResource QuietLabel}" FontSize="11" Margin="0,5,0,0"/>
                <Grid Height="128" Margin="0,18,0,0">
                    <StackPanel IsHitTestVisible="False">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.35" Margin="0,8,0,0"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.35" Margin="0,51,0,0"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,51,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="HourlyUsageBars" ItemsSource="{Binding TodayHours}" Margin="0,8,0,16">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HourButton}" ToolTip="{Binding DetailText}" AutomationProperties.Name="{Binding DetailText}">
                                    <Border Height="{Binding BarHeight}" Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoTodayHourlyUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource TodayNoHourlyData}" Style="{StaticResource QuietLabel}" TextAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="00:00" Style="{StaticResource QuietLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="1" Text="06:00" Style="{StaticResource QuietLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="12:00" Style="{StaticResource QuietLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="18:00" Style="{StaticResource QuietLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="24:00" Style="{StaticResource QuietLabel}" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3,0,0,0" Padding="12,2,0,2">
                    <TextBlock Text="{Binding TodayObservationText}" Style="{StaticResource QuietLabel}"/>
                </Border>
            </StackPanel>
        </Border>
        <local:ResponsiveColumns MinimumColumnWidth="260" MaximumColumns="2" Margin="4,22,4,0">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource RightNow}" Style="{StaticResource QuietLabel}" FontSize="10"/>
                <TextBlock Text="{Binding CurrentWindowStatus}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding CurrentStatusExplanation}" Style="{StaticResource QuietLabel}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource NextPlan}" Style="{StaticResource QuietLabel}" FontSize="10"/>
                <TextBlock Text="{Binding NextPlanText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </local:ResponsiveColumns>
    </StackPanel>
</UserControl>
