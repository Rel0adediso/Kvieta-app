<Window x:Class="Kvieta.App.TemporaryAllowanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kvieta.App.Controls;assembly=Kvieta.Controls"
        Width="500" Height="485" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0"><TextBlock Text="Kvieta" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="×" Width="27" Height="27" Padding="0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" /></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,23,28,25"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource TemporaryAllowanceTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{DynamicResource TemporaryAllowanceDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,18" />
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{DynamicResource DateLabel}" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousDateButton" Content="‹" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="PreviousDate_Click" AutomationProperties.Name="{DynamicResource PreviousDay}"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedDateText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="SelectedDayText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="›" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="NextDate_Click" AutomationProperties.Name="{DynamicResource NextDay}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button Content="{DynamicResource Today}" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" Padding="10,4" Click="TodayDate_Click"/>
                        <Button Content="{DynamicResource Tomorrow}" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" Padding="10,4" Margin="6,0,0,0" Click="TomorrowDate_Click"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{DynamicResource StartUpper}" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" /><controls:TimeWheelPicker x:Name="StartInput" TimeText="18:00" Height="35" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource EndUpper}" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" /><controls:TimeWheelPicker x:Name="EndInput" TimeText="21:00" Height="35" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource ExtraMinutesLabel}" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" /><TextBox x:Name="MinutesInput" Text="60" Height="35" Padding="10,6" /></StackPanel>
                </Grid>
                <StackPanel Grid.Row="4" Margin="0,13,0,0"><TextBlock Text="{DynamicResource NoteOptionalLabel}" Style="{StaticResource DialogLabelStyle}" Margin="0,0,0,6" /><TextBox x:Name="NoteInput" Height="35" Padding="10,6" /></StackPanel>
                <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0" /><Button Content="{DynamicResource AddAllowance}" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" MinWidth="110" /></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
